# Copy this file to ".env" and fill in the values. Never commit the real ".env" file.

# Base64 encoded 32-byte key used to encrypt secrets stored in the database (SMTP password, 2FA secrets).
# Generate one with:  openssl rand -base64 32
# Keep it safe: if it is lost, stored secrets cannot be decrypted anymore.
SECURITY_ENCRYPTION_KEY=

# Image tag to run. make-docker.bat sets it from <Version> in SharingSystem.Web.csproj; leave it unset to run "latest".
# APP_VERSION=1.0.0

# Host port the application is published on.
APP_PORT=3000

# Maximum size of one HTTP request in bytes (upload chunks must fit into it). Default: 100 MB.
UPLOAD_MAX_REQUEST_BODY_BYTES=104857600

# Free disk space that is always kept in reserve; uploads and zip archives that would use it are rejected. Default: 1 GB.
STORAGE_MIN_FREE_DISK_SPACE_BYTES=1073741824

# Maximum number of "download all" zip archives that are built at the same time. Default: 2.
STORAGE_MAX_CONCURRENT_ARCHIVE_BUILDS=2

# Automatic database snapshots (inside the data volume, folder "backups"): interval and number of kept snapshots.
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_COUNT=28

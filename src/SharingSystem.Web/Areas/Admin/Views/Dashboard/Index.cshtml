@model DashboardStatsDto
@{
    ViewData["Title"] = Localizer["Administration"].Value;
}
<div class="page-header"><h1>@Localizer["Administration"]</h1></div>
<partial name="_AdminNav" />

<div class="stats">
    <div class="card stat"><svg class="icon"><use href="#i-users" /></svg><div><div class="stat-value">@Model.UserCount</div><div class="stat-label">@Localizer["Users"]</div></div></div>
    <div class="card stat"><svg class="icon"><use href="#i-link" /></svg><div><div class="stat-value">@Model.ShareCount</div><div class="stat-label">@Localizer["Shares"]</div></div></div>
    <div class="card stat"><svg class="icon"><use href="#i-file" /></svg><div><div class="stat-value">@Model.FileCount</div><div class="stat-label">@Localizer["Files"]</div></div></div>
    <div class="card stat"><svg class="icon"><use href="#i-database" /></svg><div><div class="stat-value">@ViewFormat.Bytes(Model.TotalStorageBytes)</div><div class="stat-label">@Localizer["Storage used"]</div></div></div>
    <div class="card stat"><svg class="icon"><use href="#i-eye" /></svg><div><div class="stat-value">@Model.TotalViews</div><div class="stat-label">@Localizer["Total views"]</div></div></div>
    <div class="card stat"><svg class="icon"><use href="#i-inbox" /></svg><div><div class="stat-value">@Model.ActiveReverseShareCount</div><div class="stat-label">@Localizer["Active reverse shares"]</div></div></div>
</div>

<div class="grid grid-3">
    <a class="card link-card" href="/admin/users"><h3>@Localizer["User management"]</h3><p class="muted">@Localizer["Create, edit and delete users and manage administrator rights."]</p></a>
    <a class="card link-card" href="/admin/shares"><h3>@Localizer["Share management"]</h3><p class="muted">@Localizer["See all shares of all users and delete them."]</p></a>
    <a class="card link-card" href="/admin/settings"><h3>@Localizer["Configuration"]</h3><p class="muted">@Localizer["General, share, e-mail, SMTP and legal settings."]</p></a>
</div>

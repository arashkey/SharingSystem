@model EditUserForm
@{
    ViewData["Title"] = "Edit user";
}
<div class="page-header"><h1>Edit user</h1></div>
<partial name="_AdminNav" />

<div class="narrow">
    <form method="post" asp-antiforgery="true" action="/admin/users/@Model.Id/edit" class="card form">
        <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>
        <input type="hidden" asp-for="TotpEnabled" />
        <div class="form-group">
            <label asp-for="Username"></label>
            <input asp-for="Username" class="input" />
            <span asp-validation-for="Username" class="field-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Email"></label>
            <input asp-for="Email" class="input" />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="NewPassword"></label>
            <input asp-for="NewPassword" class="input" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="field-error"></span>
        </div>
        <label class="checkbox"><input asp-for="IsAdmin" /><span>@Html.DisplayNameFor(m => m.IsAdmin)</span></label>
        @if (Model.TotpEnabled)
        {
            <label class="checkbox"><input asp-for="DisableTotp" /><span>@Html.DisplayNameFor(m => m.DisableTotp)</span></label>
        }
        <div class="actions end">
            <a class="btn btn-secondary" href="/admin/users">Cancel</a>
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </form>
</div>

@model CreateUserForm
@{
    ViewData["Title"] = "Create user";
}
<div class="page-header"><h1>Create user</h1></div>
<partial name="_AdminNav" />

<div class="narrow">
    <form method="post" asp-antiforgery="true" action="/admin/users/create" class="card form">
        <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>
        <div class="form-group">
            <label asp-for="Username"></label>
            <input asp-for="Username" class="input" autofocus />
            <span asp-validation-for="Username" class="field-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Email"></label>
            <input asp-for="Email" class="input" />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Password"></label>
            <input asp-for="Password" class="input" autocomplete="new-password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>
        <label class="checkbox"><input asp-for="IsAdmin" /><span>@Html.DisplayNameFor(m => m.IsAdmin)</span></label>
        <div class="actions end">
            <a class="btn btn-secondary" href="/admin/users">Cancel</a>
            <button type="submit" class="btn btn-primary">Create</button>
        </div>
    </form>
</div>

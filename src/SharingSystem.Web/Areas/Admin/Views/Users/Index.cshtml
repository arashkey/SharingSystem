@model PagedResult<UserDto>
@{
    ViewData["Title"] = Localizer["Users"].Value;
    // After a delete the administrator returns to the same page of the list.
    var returnUrl = Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString;
}
<div class="page-header">
    <h1>@Localizer["User management"]</h1>
    <a class="btn btn-primary" href="/admin/users/create"><svg class="icon"><use href="#i-plus" /></svg>@Localizer["Create user"]</a>
</div>
<partial name="_AdminNav" />

<div class="card table-card">
    <div class="table-scroll">
        <table class="table">
            <thead>
                <tr><th>@Localizer["Username"]</th><th>@Localizer["E-mail"]</th><th>@Localizer["Role"]</th><th>@Localizer["2FA"]</th><th>@Localizer["Shares"]</th><th>@Localizer["Created"]</th><th class="text-right">@Localizer["Actions"]</th></tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Items)
                {
                    <tr>
                        <td class="strong">@user.Username</td>
                        <td>@user.Email</td>
                        <td>@if (user.IsAdmin) { <span class="badge badge-primary">@Localizer["Admin"]</span> } else { <span class="badge">@Localizer["User"]</span> }</td>
                        <td>@if (user.TotpEnabled) { <span class="badge badge-success">@Localizer["On"]</span> } else { <span class="muted">@Localizer["Off"]</span> }</td>
                        <td>@user.ShareCount</td>
                        <td><time data-utc="@ViewFormat.Iso(user.CreatedAt)" data-date-only></time></td>
                        <td class="text-right nowrap">
                            <a class="btn btn-ghost btn-icon" href="/admin/users/@user.Id/edit" title="@Localizer["Edit"]"><svg class="icon"><use href="#i-edit" /></svg></a>
                            <form method="post" asp-antiforgery="true" action="/admin/users/@user.Id/delete" class="inline-form" data-confirm="@Localizer["Delete {0} and all of their shares?", user.Username]">
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <button type="submit" class="btn btn-ghost btn-icon text-danger" title="@Localizer["Delete"]"><svg class="icon"><use href="#i-trash" /></svg></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<partial name="_Pagination" model="Model" />

@model ErrorViewModel
@{
    ViewData["Title"] = Localizer["Error"].Value;
}
<div class="center-page">
    <div class="card empty-state">
        <div class="error-code">@Model.StatusCode</div>
        <h1>@Localizer["Oops!"]</h1>
        <p class="muted">@Model.Message</p>
        <a class="btn btn-primary" href="/">@Localizer["Back to home"]</a>
    </div>
</div>

@model ShareListViewModel
@{
    var isAdminView = ViewData["AdminView"] is true;
    var deleteBase = isAdminView ? "/admin/shares" : "/account/shares";
}
@if (Model.Shares.Count == 0)
{
    <div class="card empty-state">
        <svg class="icon empty-icon"><use href="#i-link" /></svg>
        <h2>@Localizer["It's empty here 👀"]</h2>
        <p class="muted">@Localizer["There are no shares yet."]</p>
        @if (!isAdminView)
        {
            <a class="btn btn-primary" href="/upload">@Localizer["Create a share"]</a>
        }
    </div>
}
else
{
    <div class="card table-card">
        <div class="table-scroll">
            <table class="table">
                <thead>
                    <tr>
                        <th>@Localizer["Name"]</th>
                        @if (isAdminView)
                        {
                            <th>@Localizer["Creator"]</th>
                        }
                        <th>@Localizer["Files"]</th>
                        <th>@Localizer["Size"]</th>
                        <th>@Localizer["Views"]</th>
                        <th>@Localizer["Expires"]</th>
                        <th class="text-right">@Localizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var share in Model.Shares)
                    {
                        var url = $"{Model.BaseUrl}/s/{share.Id}";
                        var expired = ViewFormat.IsExpired(share.ExpiresAt);
                        <tr>
                            <td>
                                <a href="/s/@share.Id" class="strong">@(share.Name ?? share.Id)</a>
                                <div class="small muted">
                                    @share.Id
                                    @if (share.HasPassword)
                                    {
                                        <svg class="icon icon-xs" aria-label="@Localizer["Password protected"]"><use href="#i-lock" /></svg>
                                    }
                                    @if (share.IsCreatorOnly)
                                    {
                                        <span class="badge">@Localizer["Private"]</span>
                                    }
                                </div>
                            </td>
                            @if (isAdminView)
                            {
                                <td>@(share.CreatorUsername ?? Localizer["Anonymous"].Value)</td>
                            }
                            <td>@share.FileCount</td>
                            <td>@ViewFormat.Bytes(share.TotalSize)</td>
                            <td>@share.Views@(share.MaxViews.HasValue ? $" / {share.MaxViews}" : string.Empty)</td>
                            <td>
                                @if (share.ExpiresAt is null)
                                {
                                    <span class="muted">@Localizer["Never"]</span>
                                }
                                else
                                {
                                    <time data-utc="@ViewFormat.Iso(share.ExpiresAt.Value)" class="@(expired ? "text-danger" : string.Empty)"></time>
                                }
                            </td>
                            <td class="text-right nowrap">
                                <button type="button" class="btn btn-ghost btn-icon" data-copy="@url" title="@Localizer["Copy link"]"><svg class="icon"><use href="#i-copy" /></svg></button>
                                @if (!isAdminView)
                                {
                                    <a class="btn btn-ghost btn-icon" href="/account/shares/@share.Id/edit" title="@Localizer["Edit"]"><svg class="icon"><use href="#i-edit" /></svg></a>
                                }
                                <form method="post" asp-antiforgery="true" action="@deleteBase/@share.Id/delete" class="inline-form" data-confirm="@Localizer["Do you really want to delete this share and all of its files?"]">
                                    <button type="submit" class="btn btn-ghost btn-icon text-danger" title="@Localizer["Delete"]"><svg class="icon"><use href="#i-trash" /></svg></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<dialog class="dialog" id="share-result">
    <div class="dialog-header">
        <h2>@Localizer["Share ready"]</h2>
    </div>
    <div class="dialog-body">
        <div data-result-public>
            <p class="muted">@Localizer["Copy the link below and send it to anyone you want to share the files with."]</p>
            <div class="input-group">
                <input class="input" dir="ltr" readonly data-result-url />
                <button type="button" class="btn btn-primary" data-copy-from="[data-result-url]"><svg class="icon"><use href="#i-copy" /></svg>@Localizer["Copy"]</button>
            </div>
            <p class="small muted" data-result-expiration></p>
        </div>
        <div data-result-private hidden>
            <p>@Localizer["Your files have been uploaded successfully. The owner of the link has access to them."]</p>
        </div>
    </div>
    <div class="dialog-footer">
        <a class="btn btn-secondary" href="" data-result-open>@Localizer["Open share"]</a>
        <button type="button" class="btn btn-primary" data-result-done>@Localizer["Done"]</button>
    </div>
</dialog>

@model SharePasswordViewModel
@{
    ViewData["Title"] = "Password required";
}
<div class="auth-page">
    <div class="card auth-card">
        <div class="lock-icon"><svg class="icon"><use href="#i-lock" /></svg></div>
        <h1>Password required</h1>
        <p class="muted">This share is protected. Please enter the password to access it.</p>
        <form method="post" asp-antiforgery="true" action="/s/@Model.ShareId/unlock" class="form">
            <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>
            <div class="form-group">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="input" autocomplete="off" autofocus />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>
            <button type="submit" class="btn btn-primary btn-block">Submit</button>
        </form>
    </div>
</div>

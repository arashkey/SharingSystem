@model ReverseSharesPageViewModel
@{
    ViewData["Title"] = Localizer["Reverse shares"].Value;
    // After a delete the user returns to the same page of the list.
    var returnUrl = Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString;
}
<div class="page-header">
    <div>
        <h1>@Localizer["Reverse shares"]</h1>
        <p class="muted">@Localizer["A reverse share is a link that allows other people to upload files to you — even without an account."]</p>
    </div>
    <button type="button" class="btn btn-primary" data-dialog-open="create-reverse-share"><svg class="icon"><use href="#i-plus" /></svg>@Localizer["Create"]</button>
</div>

@if (Model.ReverseShares.TotalCount == 0)
{
    <div class="card empty-state">
        <svg class="icon empty-icon"><use href="#i-inbox" /></svg>
        <h2>@Localizer["It's empty here 👀"]</h2>
        <p class="muted">@Localizer["You don't have any reverse shares yet."]</p>
    </div>
}
else
{
    <div class="card table-card">
        <div class="table-scroll">
            <table class="table">
                <thead>
                    <tr>
                        <th>@Localizer["Shares"]</th>
                        <th>@Localizer["Remaining uses"]</th>
                        <th>@Localizer["Max. share size"]</th>
                        <th>@Localizer["Expires"]</th>
                        <th>@Localizer["Options"]</th>
                        <th class="text-right">@Localizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var reverseShare in Model.ReverseShares.Items)
                    {
                        <tr>
                            <td>
                                @if (reverseShare.Shares.Count == 0)
                                {
                                    <span class="muted">@Localizer["No shares created yet"]</span>
                                }
                                else
                                {
                                    <details>
                                        <summary>@Localizer["{0} share(s)", reverseShare.Shares.Count]</summary>
                                        <ul class="plain-list">
                                            @foreach (var share in reverseShare.Shares.Where(s => s.IsCompleted))
                                            {
                                                <li><a href="/s/@share.Id">@(share.Name ?? share.Id)</a> <span class="small muted">@ViewFormat.Bytes(share.TotalSize)</span></li>
                                            }
                                        </ul>
                                    </details>
                                }
                            </td>
                            <td>@reverseShare.RemainingUses</td>
                            <td>@ViewFormat.Bytes(reverseShare.MaxShareSizeBytes)</td>
                            <td><time data-utc="@ViewFormat.Iso(reverseShare.ExpiresAt)" class="@(ViewFormat.IsExpired(reverseShare.ExpiresAt) ? "text-danger" : string.Empty)"></time></td>
                            <td class="small">
                                @if (reverseShare.IsSimplified) { <span class="badge">@Localizer["Simplified"]</span> }
                                @if (!reverseShare.IsPublicAccess) { <span class="badge">@Localizer["Private"]</span> }
                                @if (reverseShare.SendEmailNotification) { <span class="badge">@Localizer["E-mail"]</span> }
                            </td>
                            <td class="text-right nowrap">
                                <button type="button" class="btn btn-ghost btn-icon" data-copy="@reverseShare.Url" title="@Localizer["Copy link"]"><svg class="icon"><use href="#i-copy" /></svg></button>
                                <form method="post" asp-antiforgery="true" action="/account/reverse-shares/@reverseShare.Id/delete" class="inline-form" data-confirm="@Localizer["Delete this reverse share? Shares created with it are kept."]">
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="btn btn-ghost btn-icon text-danger" title="@Localizer["Delete"]"><svg class="icon"><use href="#i-trash" /></svg></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <partial name="_Pagination" model="Model.ReverseShares" />
}

<dialog class="dialog" id="create-reverse-share" data-open-on-load="@(ViewData.ModelState.IsValid ? "false" : "true")">
    <form method="post" asp-antiforgery="true" action="/account/reverse-shares" class="form">
        <div class="dialog-header">
            <h2>@Localizer["Create reverse share"]</h2>
            <button type="button" class="btn btn-ghost btn-icon" data-dialog-close aria-label="@Localizer["Close"]"><svg class="icon"><use href="#i-x" /></svg></button>
        </div>
        <div class="dialog-body">
            <div asp-validation-summary="All" class="alert alert-error"></div>
            <div class="form-group">
                <label>@Localizer["Link expiration"]</label>
                <partial name="_ExpirationInput" for="Form.Expiration" view-data='new ViewDataDictionary(ViewData) { ["HideNever"] = true }' />
            </div>
            <div class="grid grid-2 tight">
                <div class="form-group">
                    <label asp-for="Form.MaxShareSizeMegabytes"></label>
                    <input asp-for="Form.MaxShareSizeMegabytes" class="input" min="1" />
                    <span class="small muted">@Localizer["At most {0}", ViewFormat.Bytes(Model.MaxShareSizeBytes)]</span>
                </div>
                <div class="form-group">
                    <label asp-for="Form.MaxUseCount"></label>
                    <input asp-for="Form.MaxUseCount" class="input" min="1" />
                </div>
            </div>
            @if (Model.CanSendEmails)
            {
                <label class="checkbox"><input asp-for="Form.SendEmailNotification" /><span>@Html.DisplayNameFor(m => m.Form.SendEmailNotification)</span></label>
            }
            <label class="checkbox"><input asp-for="Form.IsSimplified" /><span>@Html.DisplayNameFor(m => m.Form.IsSimplified)</span></label>
            <label class="checkbox"><input asp-for="Form.IsPublicAccess" /><span>@Html.DisplayNameFor(m => m.Form.IsPublicAccess)</span></label>
        </div>
        <div class="dialog-footer">
            <button type="button" class="btn btn-secondary" data-dialog-close>@Localizer["Cancel"]</button>
            <button type="submit" class="btn btn-primary">@Localizer["Create"]</button>
        </div>
    </form>
</dialog>

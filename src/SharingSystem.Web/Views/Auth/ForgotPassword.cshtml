@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
}
<div class="auth-page">
    <div class="card auth-card">
        <h1>Forgot your password?</h1>
        <p class="muted">Enter your e-mail address and we will send you a link to reset your password.</p>
        <form method="post" asp-antiforgery="true" action="/auth/forgot-password" class="form">
            <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>
            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="input" autocomplete="email" autofocus />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>
            <button type="submit" class="btn btn-primary btn-block">Send reset link</button>
            <a class="small center" href="/auth/sign-in">Back to sign in</a>
        </form>
    </div>
</div>

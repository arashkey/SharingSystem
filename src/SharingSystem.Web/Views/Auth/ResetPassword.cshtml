@model ResetPasswordViewModel
@{
    ViewData["Title"] = Localizer["Reset password"].Value;
}
<div class="auth-page">
    <div class="card auth-card">
        <h1>@Localizer["Reset password"]</h1>
        <form method="post" asp-antiforgery="true" action="/auth/reset-password/@Model.Token" class="form">
            <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>
            <input type="hidden" asp-for="Token" />
            <div class="form-group">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="input" autocomplete="new-password" autofocus />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" class="input" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>
            <button type="submit" class="btn btn-primary btn-block">@Localizer["Change password"]</button>
        </form>
    </div>
</div>

@model SignInViewModel
@{
    ViewData["Title"] = Localizer["Sign in"].Value;
}
<div class="auth-page">
    <div class="card auth-card">
        <h1>@Localizer["Welcome back"]</h1>
        @if (Model.CanRegister)
        {
            <p class="muted">@Localizer["You don't have an account yet?"] <a href="/auth/sign-up">@Localizer["Sign up"]</a></p>
        }
        <form method="post" asp-antiforgery="true" action="/auth/sign-in" class="form">
            <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="form-group">
                <label asp-for="EmailOrUsername"></label>
                <input asp-for="EmailOrUsername" class="input ltr" autocomplete="username" autofocus />
                <span asp-validation-for="EmailOrUsername" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="input" autocomplete="current-password" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>
            @if (Model.CanResetPassword)
            {
                <a class="small" href="/auth/forgot-password">@Localizer["Forgot your password?"]</a>
            }
            <button type="submit" class="btn btn-primary btn-block">@Localizer["Sign in"]</button>
        </form>
    </div>
</div>
